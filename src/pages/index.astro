---
import SiteLayout from '../layouts/SiteLayout.astro';
import Arrow from '../components/Arrow.astro';
import AppPlayground from '../components/AppPlayground.astro';
import { apps } from '../data/apps';
const collections = [
  {name: 'Games', line: 'One more level. One more try.', category: 'Games', filter:'games'},
  {name: 'Everyday', line: 'A little help goes a long way.', category: 'Everyday', filter:'everyday'},
  {name: 'Companions', line: 'Keep your favorite things close.', category: 'Companions', filter:'companions'},
];
---
<SiteLayout>
  <AppPlayground />
  <div class="directory-surface"><section class="collection-directory container" aria-labelledby="collection-heading">
    <div class="directory-heading"><p class="eyebrow">The collection</p><h2 id="collection-heading">Find your kind<br /> of app.</h2></div>
    <div class="directory-rows">{collections.map(collection => <a class="directory-row" href={`/apps/?category=${collection.filter}`}>
      <div class="directory-icons" aria-hidden="true">{apps.filter(app => app.category === collection.category).slice(0,3).map(app => <img src={app.icon} width="64" height="64" alt="" loading="lazy" />)}</div>
      <div class="directory-copy"><h3>{collection.name}</h3><p>{collection.line}</p></div><span class="directory-count">{apps.filter(app => app.category === collection.category).length} apps</span><Arrow diagonal />
    </a>)}</div>
  </section></div>
  <section class="home-about container" id="maker">
    <div><p class="eyebrow">The person behind the apps</p><h2>Hi, I’m<br />Chris Houston.</h2></div>
    <div><p>I build mobile games, useful tools, and apps for the things people love. Every app here is built and supported independently.</p><a class="text-link" href="mailto:dev.chrishouston@gmail.com">Get in touch <Arrow diagonal /></a></div>
  </section>
  <section class="home-support container"><div><h2>Need a hand?</h2><p>Questions, feedback, or something not working? I’m here to help.</p></div><a class="button button-dark" href="/support/">Get app support <Arrow diagonal /></a></section>
</SiteLayout>
